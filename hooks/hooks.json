{
  "description": "Regras do analista no inicio da sessao e travas: segredo, banco fora do MCP e commit de dados",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/travas.mjs", "sessao"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|Grep",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/travas.mjs", "pre"], "timeout": 15 }
        ]
      }
    ]
  }
}
